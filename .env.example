# Server-side environment variables. Copy the relevant keys into `.env.local` (never commit it).

# Serves the full one-page site on /preview. Set to true in the Vercel Preview and Development
# environments, never in Production. Playwright and CI set it to true to test /preview.
ENABLE_PREVIEW_ROUTE=false

# Baserow waitlist. Server-side only: never prefix these with NEXT_PUBLIC_. Baserow Cloud is hosted
# in the EU, so the waitlist e-mail stays inside the EU. Create a database token that has only the
# "create" permission on the waitlist table. Leave the token and table id unset in environments
# without a waitlist table; the form then answers with its generic server error.
# BASEROW_API_URL is optional and defaults to Baserow Cloud; set it to the https URL of a
# self-hosted instance instead.
# BASEROW_API_URL=https://api.baserow.io
# BASEROW_TOKEN=
# BASEROW_WAITLIST_TABLE_ID=

# Assistant Chatbot LLM
# MISTRAL_API_KEY=

# Shared rate limit of the assistant route, over the Upstash Redis REST API. Server-side only:
# never prefix these with NEXT_PUBLIC_. Leave both unset in development and test to keep the
# in-memory window; in production the assistant answers its generic error until both are set.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
