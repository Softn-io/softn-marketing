# Server-side environment variables. Copy the relevant keys into `.env.local` (never commit it).

# Serves the full one-page site on /preview. Set to true in the Vercel Preview and Development environments, never in Production. Playwright and CI set it to true to test /preview.
ENABLE_PREVIEW_ROUTE=false

# Baserow. Server-side only: never prefix these with NEXT_PUBLIC_. Baserow Cloud is hosted in the EU, so the lead data and the waitlist e-mail stay inside the EU. Create a database token that has the "create" permission on the waitlist table and the leads table, and the "update" permission on the leads table (a booking stores its row id in the calendar event, and a reschedule or a cancellation updates that row). Leave the token and the table ids unset in environments without those tables: the waitlist form then answers its generic server error, and a booking still succeeds, with the storage failure logged as a code.
# BASEROW_API_URL is optional and defaults to Baserow Cloud; set it to the https URL of a self-hosted instance instead.
# Baserow leads table of the booking made in the chat. Server-side only: never prefix these with NEXT_PUBLIC_. Leave BASEROW_LEADS_TABLE_ID unset in an environment that must not store leads: the booking still succeeds there and the failure is logged as a code.

# BASEROW_API_URL=https://api.baserow.io
# BASEROW_TOKEN=
# BASEROW_WAITLIST_TABLE_ID=
# BASEROW_LEADS_TABLE_ID=

# Assistant Chatbot LLM
# MISTRAL_API_KEY=

# Shared rate limit of the assistant route, over the Upstash Redis REST API. Server-side only: never prefix these with NEXT_PUBLIC_. Leave both unset in development and test to keep the in-memory window; in production the assistant answers its generic error until both are set.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# Google Calendar booking. Server-side only: never prefix these with NEXT_PUBLIC_. No service-account key is stored: the server authenticates keyless through Workload Identity Federation, presenting the deployment's Vercel OIDC token (the x-vercel-oidc-token request header first, VERCEL_OIDC_TOKEN as the development fallback). Domain-wide delegation is what lets the service account act for the Workspace user in GOOGLE_CALENDAR_OWNER, the identity the calls are made for; GOOGLE_CALENDAR_ID is the calendar the bookings are written to, a dedicated secondary calendar whose id is its address (abc123@group.calendar.google.com). Free/busy also reads the owner's own calendar, so a busy owner is never booked over.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_CALENDAR_OWNER=
# GOOGLE_CALENDAR_ID=
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# VERCEL_OIDC_TOKEN=

# Manage link of a booking, signed with this secret (at least 32 characters). Server-side only: never prefix it with NEXT_PUBLIC_. It signs the link the calendar invitation carries, which lets the visitor reschedule or cancel. Leave it unset in an environment that must not offer that link: the booking still succeeds without the manage line in the description, and every manage link is refused.
# BOOKING_LINK_SECRET=